<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="target_person">
    <static>false</static>

    <link name="person">
      <gravity>false</gravity>
      <visual name="body">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.35 1.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.25 0.9 1</ambient>
          <diffuse>0.1 0.25 0.9 1</diffuse>
        </material>
      </visual>

      <visual name="head">
        <pose>0 0 1.32 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.75 0.5 0.3 1</ambient>
          <diffuse>0.75 0.5 0.3 1</diffuse>
        </material>
      </visual>

      <visual name="tracking_marker">
        <pose>0 0 1.58 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4 0.4 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
          <emissive>0 0.2 0.2 1</emissive>
        </material>
      </visual>
    </link>

    <plugin
      filename="DeterministicPathPlugin"
      name="DeterministicPathPlugin">
      <speed>0.75</speed>
      <waypoints>
        <waypoint>-4 -3</waypoint>
        <waypoint>-4 -8</waypoint>
        <waypoint>2 -8</waypoint>
        <waypoint>2 -3</waypoint>
      </waypoints>
    </plugin>

    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <topic>/world/iris_runway/model/target_person/pose</topic>
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>10</update_frequency>
    </plugin>
  </model>
</sdf>
