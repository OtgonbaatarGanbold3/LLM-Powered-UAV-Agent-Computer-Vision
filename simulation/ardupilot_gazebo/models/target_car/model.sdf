<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="target_car">
    <static>true</static>

    <link name="chassis">
      <!-- Main Car Body (Red) -->
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>1.5 0.8 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.15 0.15 1</ambient>
          <diffuse>0.85 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- High-Contrast Tracking Target on Roof (Bright Yellow Pad) -->
      <visual name="roof_marker">
        <pose>0 0 0.205 0 0 0</pose>
        <geometry>
          <box>
            <size>0.6 0.6 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.9 0.0 1</ambient>
          <diffuse>1.0 0.9 0.0 1</diffuse>
          <emissive>0.2 0.2 0.0 1</emissive>
        </material>
      </visual>
    </link>

    <plugin
      filename="DeterministicPathPlugin"
      name="DeterministicPathPlugin">
      <speed>0.75</speed>
      <waypoints>
        <waypoint>2 3</waypoint>
        <waypoint>2 8</waypoint>
        <waypoint>-4 8</waypoint>
        <waypoint>-4 3</waypoint>
      </waypoints>
    </plugin>

    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <topic>/world/iris_runway/model/target_car/pose</topic>
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>10</update_frequency>
    </plugin>

  </model>
</sdf>
